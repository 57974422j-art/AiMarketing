{
  "name": "ai-marketing",
  "version": "1.0.90",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder",
    "electron:start": "electron .",
    "release:electron": "node scripts/release-electron.mjs",
    "postinstall": "npx prisma generate && npx prisma db push; true"
  },
  "main": "electron/main.js",
  "dependencies": {
    "@alicloud/nls-filetrans-2018-08-17": "^1.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@jackwener/opencli": "^1.8.6",
    "@prisma/client": "^5.22.0",
    "@types/three": "^0.185.3",
    "ali-oss": "^6.23.0",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.3.0",
    "lunar-javascript": "^1.7.7",
    "next": "14.2.0",
    "playwright": "1.60.0",
    "playwright-extra": "^4.3.6",
    "pptxgenjs": "^4.0.1",
    "prisma": "5.22.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.1",
    "sherpa-onnx-node": "^1.13.6",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "20.11.0",
    "@types/react": "18.2.43",
    "@types/react-dom": "18.2.17",
    "autoprefixer": "10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "8.55.0",
    "eslint-config-next": "14.0.4",
    "postcss": "8.4.32",
    "tailwindcss": "3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "asarUnpack": [
      "**/node_modules/@jackwener/opencli/**"
    ],
    "appId": "com.aimarketing.app",
    "productName": "AI营销助手",
    "directories": {
      "output": "dist-rel"
    },
    "files": [
      ".next/**/*",
      "electron/**/*",
      "public/**/*",
      "!public/updates/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/platform-tools",
        "to": "scripts/platform-tools"
      },
      {
        "from": "scripts/scrcpy",
        "to": "scripts/scrcpy"
      },
      {
        "from": "C:/Users/Administrator/AppData/Local/ms-playwright",
        "to": "ms-playwright",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png",
      "artifactName": "AI-Marketing-Setup-${version}.exe"
    },
    "publish": {
      "provider": "generic",
      "url": "https://ai-niuma.cc/updates"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "electron/installer.nsh"
    }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
