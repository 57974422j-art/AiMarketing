// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  username        String   @unique
  passwordHash    String
  name            String?
  role            String   @default("end-user") // admin / editor / end-user / viewer
  parentId        Int?                          // 上级ID：editor指向admin，end-user指向editor
  inviteCode      String?
  plan            String   @default("free")
  teamId          Int?
  isAgent         Boolean  @default(false)
  agentInviteCode String?
  agentName       String?   // 自定义 AI 名称（客户起名，2026-08-07）
  industry        String?   // 客户行业（2026-08-09：视频/热点按行业推送）
  storyboards     StoryboardTask[]
  agentTtsVoice   String?   // AI 语音音色（2026-08-07 设置：用户级）
  agentTemperature Float?    // AI 回复温度（0~1.5）
  agentVadThreshold Float?   // 语音 VAD 音量阈值（0~0.15）
  agentVadSilence  Int?      // 语音断句静音毫秒（1000~4000）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        Account[]
  videoTasks      VideoTask[]
  copyTasks       CopyTask[]
  publishingTasks PublishingTask[]
  dashboardStats  DashboardStat[]
  projects        Project[]
  createdInvites  InviteCode[]          @relation("InviteCodeCreator")
  usedInvite      InviteCode?           @relation("InviteCodeUsed")
  usageLogs       UsageLog[]
  teamMembers     TeamMember[]
  createdTeams    Team[]                @relation("TeamOwner")

  // 三层管理关联
  parent                  User?               @relation("UserParent", fields: [parentId], references: [id])
  children                User[]              @relation("UserParent")
  devicePools             DevicePool[]
  devices                 Device[]
  socialAccounts          SocialAccount[]
  submittedSubmissions    ContentSubmission[] @relation("Submitter")
  reviewedSubmissions     ContentSubmission[] @relation("Reviewer")
  createdTasks            AutomationTask[]
  poiAddresses            PoiAddress[]
  scriptTemplates         ScriptTemplate[]
  accountGroups           AccountGroup[]
  mediaAssets             MediaAsset[]
  automationTemplates     AutomationTemplate[]
  copyTemplates           CopyTemplate[]
  aiAgents                AIAgent[]
  phyDevices              PhyDevice[]
  taskConfigs             TaskConfig[]  
  filterPresets           FilterPreset[]
  editorQuota             EditorQuota?           // 资源配额（仅 editor 有）
  paidFeatures            String?                // JSON: 已开通的付费功能 ["text-to-video", "image-generator"]
  videoEditCount          Int      @default(0)   // 一键成片/后期处理使用量统计
  copyUsedToday           Int      @default(0)   // 今日AI文案已用次数
  copyLastResetDate       String?                // 文案配额上次重置日期 (YYYY-MM-DD)
  
  // V2 升级新增关系 (Phase 0-3)
  referrals               ReferralConfig[]
  leads                   Lead[]
  assignedLeads           Lead[]                @relation("LeadAssignee")
  collectionTasks         CollectionTask[]
  liveRooms               LiveRoom[]
  subscriptions           UserSubscription[]
  paymentOrders           PaymentOrder[]
  generationRecords       GenerationRecord[]    // 生成记录总表（虚拟关系，不产生数据库列）
  feedbacks               Feedback[]            // 问题反馈（虚拟关系，不产生数据库列）
  contentDrafts           ContentDraft[]        // 发布内容草稿箱（虚拟关系，不产生数据库列）
  chatSessions            ChatSession[]
  pointBalance            Int      @default(0)  // 点卡永久点数余额（1点=¥0.01，不过期；扣费顺序=月额度优先、余额兜底）
  pointCardOrders         PointCardOrder[]
  agentPublishTasks      AgentPublishTask[]
}

model DevicePool {
  id           Int      @id @default(autoincrement())
  ownerId      Int                           // 所属二级客户 (editor)
  totalWindows Int      @default(0)          // 总窗口配额（一共可用多少个窗口）
  usedWindows  Int      @default(0)          // 已绑定账号的窗口数
  dailyQuota   Int      @default(12)         // 每日可刷新窗口数（Q1单次12个，关窗后可再开一批）
  createdAt    DateTime @default(now())

  owner    User            @relation(fields: [ownerId], references: [id])
  sessions WindowSession[]
}

// EditorQuota: editor 资源配额（admin 分配，系统自动分配端口）
// 替代之前手动填写 CDP 端口的方式
model EditorQuota {
  id               Int      @id @default(autoincrement())
  editorId         Int      @unique             // 所属 editor (User.id)
  q1Containers     Int      @default(0)         // Q1 容器数量上限
  q1Used           Int      @default(0)         // 已用 Q1 数量
  fingerprintPorts Int      @default(0)         // 指纹浏览器端口上限
  fingerprintUsed  Int      @default(0)         // 已用指纹端口数
  realPhones       Int      @default(0)         // 真机 ADB 数量上限
  realPhonesUsed   Int      @default(0)         // 已用真机数
  portRangeStart   Int      @default(9220)      // 端口池起始
  portRangeEnd     Int      @default(9320)      // 端口池结束
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  editor User @relation(fields: [editorId], references: [id])
}
// 窗口使用记录：Q1多窗口可后续查询分析
model WindowSession {
  id        Int      @id @default(autoincrement())
  poolId    Int                           // 关联的 DevicePool
  deviceId  Int?                          // 关联的物理Q1设备
  status    String   @default("active")   // active(进行中) / closed(已关闭) / expired(超时)
  openedAt  DateTime @default(now())      // 窗口开启时间
  closedAt  DateTime?                     // 窗口关闭时间
  taskCount Int      @default(0)          // 此窗口执行了多少个任务
  note      String?                       // 备注（绑定的账号、执行内容等）

  pool   DevicePool @relation(fields: [poolId], references: [id])
  device Device?    @relation(fields: [deviceId], references: [id])
}

model Device {
  id            Int      @id @default(autoincrement())
  name          String
  status        String   @default("offline") // online / offline / busy
  lastHeartbeat DateTime @default(now())
  groupId       String?
  ownerId       Int
  ip            String?  // Q1容器IP
  apiPort       Int?     // 安卓管理API端口
  rpaPort       Int?     // RPA触控端口
  adbPort       Int?     // ADB端口
  type          String   @default("mock") // "mock" | "q1"
  phyDeviceName String?                    // Q1物理机名称，多窗口共享同一台Q1时相同
  phyDeviceId   Int?                       // 关联的 Q1 物理机
  createdAt     DateTime @default(now())

  owner           User              @relation(fields: [ownerId], references: [id])
  phyDevice       PhyDevice?        @relation(fields: [phyDeviceId], references: [id])
  accounts        Account[]
  socialAccounts  SocialAccount[]
  automationTasks AutomationTask[]
  windowSessions  WindowSession[]
}

// Q1 物理机，一台 Q1 设备对应多条 Device 容器记录
model PhyDevice {
  id        Int      @id @default(autoincrement())
  name      String                       // 如 "办公室Q1"
  ip        String                       // 192.168.1.14
  port      Int      @default(8000)      // 管理端口
  note      String?                      // 备注
  status    String   @default("online")  // online / offline
  ownerId   Int                          // 管理员 ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  devices Device[]
}

model SocialAccount {
  id        Int      @id @default(autoincrement())
  platform  String                       // 抖音/快手/小红书等
  username  String
  password  String                       // 加密存储
  deviceId  Int?
  userId    Int
  status    String   @default("未绑定")   // 未绑定/已绑定/已封禁
  createdAt DateTime @default(now())

  user            User              @relation(fields: [userId], references: [id])
  device          Device?           @relation(fields: [deviceId], references: [id])
  accountGroupItems AccountGroupItem[]
  publishingTasks   PublishingTask[]
  agentPublishTasks  AgentPublishTask[]
}

model ContentSubmission {
  id             Int      @id @default(autoincrement())
  videoUrl       String                       // OSS地址
  caption        String                       // 文案标题
  targetPlatform String
  status         String   @default("待审核")   // 待审核/已通过/已拒绝/已发布
  submitterId    Int
  reviewerId     Int?
  createdAt      DateTime @default(now())

  submitter User  @relation("Submitter", fields: [submitterId], references: [id])
  reviewer  User? @relation("Reviewer", fields: [reviewerId], references: [id])
}

model AutomationTask {
  id               Int      @id @default(autoincrement())
  type             String                       // 互关/点赞/评论/转发/发布视频
  status           String   @default("等待中")    // 等待中/执行中/已完成/失败
  params           String   @default("{}")       // JSON
  assignedDeviceId Int?
  createdBy        Int
  createdAt        DateTime @default(now())

  device      Device?    @relation(fields: [assignedDeviceId], references: [id])
  creator     User       @relation(fields: [createdBy], references: [id])
  taskLogs    TaskLog[]
}

model TaskLog {
  id           Int      @id @default(autoincrement())
  taskId       Int
  action       String
  result       String
  errorMessage String?
  createdAt    DateTime @default(now())

  task AutomationTask @relation(fields: [taskId], references: [id])
}

// 每账号每设备独立任务配置
model TaskConfig {
  id          Int      @id @default(autoincrement())
  accountId   Int
  deviceId    Int?
  platform    String
  keywords    String   @default("[]")     // ["火锅","美业","减肥"]
  timeStart   String   @default("09:00")
  timeEnd     String   @default("23:00")
  actions     String   @default("[]")     // ["search","like","comment","follow","dm"]
  leadGen     String   @default("{}")     // 获客配置（预留）
  isActive    Boolean  @default(true)
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id])
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())

  owner     User          @relation("TeamOwner", fields: [ownerId], references: [id])
  members   TeamMember[]
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    Int
  role      String   @default("viewer")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Account {
  id          Int      @id @default(autoincrement())
  platform    String
  accountId   String
  accountName String
  isBound     Boolean  @default(false)
  bindType    String   @default("device")  // device(真机群控) / manual(指纹浏览器) / official(官方API)
  password    String   @default("")
  mobile      String   @default("")          // 手机号（绑定用）
  cdpPort     Int?                           // 指纹浏览器 CDP 调试端口（仅 manual 类型使用，系统自动分配）
  deviceId    Int?                           // 绑定的设备
  status      String   @default("未绑定")    // 未绑定/已绑定/登录异常/已封禁
  remark      String   @default("")
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  device          Device?          @relation(fields: [deviceId], references: [id])
  publishingTasks PublishingTask[]
}

model VideoTask {
  id           Int      @id @default(autoincrement())
  userId       Int
  originalFile String
  template     String
  duration     Int
  style        String
  status       String
  outputPath   String?
  progress     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  publishingTasks PublishingTask[]
}

model CopyTask {
  id         Int      @id @default(autoincrement())
  userId     Int
  keywords   String
  platform   String
  style      String
  result     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PublishingTask {
  id              Int      @id @default(autoincrement())
  userId          Int
  accountId       Int
  socialAccountId Int?
  videoTaskId     Int
  publishTime     DateTime?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  account       Account       @relation(fields: [accountId], references: [id])
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])
  videoTask     VideoTask     @relation(fields: [videoTaskId], references: [id])
}

model DashboardStat {
  id              Int      @id @default(autoincrement())
  userId          Int
  date            DateTime @default(now())
  platform        String   @default("抖音")
  followers       Int      @default(0)
  publishCount    Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  engagementRate  Float    @default(0)

  user User @relation(fields: [userId], references: [id])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("active")
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model InviteCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  role      String
  usedBy    Int?     @unique
  createdBy Int
  isActive  Boolean  @default(true)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?

  usedByUser User?  @relation("InviteCodeUsed", fields: [usedBy], references: [id])
  creator    User   @relation("InviteCodeCreator", fields: [createdBy], references: [id])
}

model UsageLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String   // "ai_copy" / "ai_image" / "video_edit" / "ai_chat" / "text_to_video" / "digital_human"
  count     Int      @default(1)
  tokens    Int?     // AI消耗的token数（如使用AI文案/AI生图等）
  model     String?  // 使用的AI模型名称（如 GPT-4o / Qwen / StableDiffusion）
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  // 【AI工具使用统计】
  // 此表记录所有AI功能的使用情况，包括：
  // - action: 功能类型（ai_copy=文案, ai_image=生图, video_edit=剪辑, etc.）
  // - tokens: 每次调用的token消耗（用于统计成本）
  // - model: 使用的模型（用于区分不同模型成本）
  // Dashboard 通过此表计算：总使用量、Token消耗、各功能使用分布
}

// ====== 收费系统 ======

model SubscriptionPlan {
  id                Int      @id @default(autoincrement())
  name              String                            // 套餐名 "基础月卡"
  description       String?                           // 套餐描述
  price             Int                               // 原价(分) 2900=¥29
  discountPrice     Int?                              // 折扣价(分) 1900=¥19
  durationMonths    Int      @default(1)              // 1=月/3=季/12=年
  // 月点数额度：手动设定优先；为 null 时按 price/durationMonths 自动算（1 点≈¥0.01，见 token-wallet.planMonthlyTokens）
  monthlyTokens     Int?                              // 覆盖值，后台套餐编辑页可手填；null=按原价/月数自动
  // 资源配额(0=不可用, -1=无限)
  deepseekTokens    Int      @default(-1)             // DeepSeek token（默认免费无限）
  llmTokens         Int      @default(0)              // Qwen LLM token
  text2imgQuota     Int      @default(0)              // 文生图次数
  text2videoQuota   Int      @default(0)              // 文生视频次数
  digitalHumanMin   Int      @default(0)              // 数字人分钟
  liveStreamMin     Int      @default(0)              // 直播分钟
  storageMb         Int      @default(100)            // 存储空间MB
  status            String   @default("active")       // active/disabled
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions UserSubscription[]
  paymentOrders PaymentOrder[]
}

model UserSubscription {
  id         Int      @id @default(autoincrement())
  userId     Int
  planId     Int
  startDate  DateTime @default(now())
  endDate    DateTime
  status     String   @default("active")              // active/expired/cancelled
  orderNo       String?   // 关联 PaymentOrder.orderNo，便于对账
  paymentMethod String?   // alipay / wechat / manual
  createdAt  DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id])
  plan       SubscriptionPlan  @relation(fields: [planId], references: [id])
}

// ═══════════════════════════════════════════════
// 支付订单 — 收款流程中间态（下单→支付→回调开通订阅）
// ═══════════════════════════════════════════════
model PaymentOrder {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique                 // 商户订单号（平台生成，唯一）
  userId    Int
  planId    Int
  channel   String   @default("alipay")      // alipay / wechat
  amount    Int                               // 金额(分)
  subject   String                            // 订单标题，如 "专业版月卡"
  status    String   @default("pending")      // pending / paid / closed / failed
  tradeNo   String?                           // 第三方交易号
  payUrl    String?                           // 支付宝 wap 支付跳转 URL
  qrCode    String?                           // 微信 Native 支付二维码内容
  expireAt  DateTime?                         // 订单过期时间
  paidAt    DateTime?
  raw       String?                           // 回调原始数据(JSON)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId],   references: [id])
  plan SubscriptionPlan @relation(fields: [planId],   references: [id])
}

// ── 点卡（永久点数充值包）──
// 点卡 ≠ 套餐：无时长概念，购买后点数直接累加到 User.pointBalance，永不过期、不按月清零。
// 扣费顺序：先扣当月套餐额度，额度用完再扣 pointBalance（见 lib/token-wallet.ts）。
model PointCard {
  id          Int      @id @default(autoincrement())
  name        String                             // 点卡名 "1000点补充包"
  description String?                            // 描述
  points      Int                                // 充值点数（1点=¥0.01）
  price       Int                                // 售价(分)
  status      String   @default("active")        // active/disabled
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders PointCardOrder[]
}

model PointCardOrder {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique                     // 商户订单号
  userId    Int
  cardId    Int
  channel   String   @default("alipay")          // alipay / wechat
  amount    Int                                  // 金额(分)
  points    Int                                  // 到账点数（下单时快照，防后台改卡影响历史订单）
  subject   String                               // 订单标题
  status    String   @default("pending")         // pending / paid / closed / failed
  tradeNo   String?
  payUrl    String?
  qrCode    String?
  expireAt  DateTime?
  paidAt    DateTime?
  raw       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id])
  card PointCard @relation(fields: [cardId], references: [id])
}

model VideoTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  prompt      String
  duration    Int      @default(30)
  style       String
  thumbnail   String?
  videoUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // 【视频模板】
  // 预置视频编辑模板，用于快速生成视频。
  // 前端/AI通过此表获取可用模板列表。
}

model CopyTemplate {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  platform  String   @default("抖音")
  style     String   @default("种草")
  tags      String?                       // JSON 数组
  status    String   @default("pending")  // pending / approved / rejected
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PoiAddress {
  id         Int      @id @default(autoincrement())
  name       String
  platform   String   @default("抖音")
  address    String
  lat        Float
  lng        Float
  category   String?
  status     String   @default("active")
  ownerId    Int
  createdAt  DateTime @default(now())

  owner      User              @relation(fields: [ownerId], references: [id])
}

model ScriptTemplate {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  platform  String   @default("抖音")
  type      String?
  tags      String?                    // JSON 数组
  ownerId   Int
  createdAt DateTime @default(now())

  owner           User              @relation(fields: [ownerId], references: [id])
}

model AccountGroup {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())

  owner  User               @relation(fields: [ownerId], references: [id])
  items  AccountGroupItem[]
}

model AccountGroupItem {
  id              Int      @id @default(autoincrement())
  groupId         Int
  socialAccountId Int
  createdAt       DateTime @default(now())

  group         AccountGroup  @relation(fields: [groupId], references: [id])
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])

  @@unique([groupId, socialAccountId])
}

model KnowledgeSite {
  id        Int      @id @default(autoincrement())
  url       String
  title     String   @default("")
  desc      String   @default("")
  category  String   @default("")   // 提示词/素材/灵感/教程等
  addedBy   Int      @default(0)    // 添加人 userId（0=系统）
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MediaAsset {
  id           Int      @id @default(autoincrement())
  title        String
  url          String?
  ossUrl       String   @default("")      // 素材真实地址（OSS），列表/播放/下载主用
  type         String   @default("video") // video / image / audio
  prompt       String   @default("")      // 素材提示词
  category     String   @default("")      // 分类（行业/类型）
  source       String   @default("public")// public 公共素材 / private 用户私有
  purpose      String   @default("")      // 用途
  industry     String   @default("")      // 行业
  platform     String   @default("")      // 平台
  thumbnailUrl String?                   // 封面
  originalUrl  String?                   // 原始链接
  orientation  String   @default("unknown") // landscape / portrait / unknown
  duration     Int?
  size         Int?
  ownerId      Int
  createdAt    DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  // 【素材库】
  // 存放上传的视频/图片/音频素材，文件本体在 OSS（ossUrl），本表仅存目录/元数据。
}

model AutomationTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   // 互关/点赞/评论/转发/发布视频
  params    String   @default("{}") // JSON
  ownerId   Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  // 【自动化任务模板】
  // 预设任务模板，可被 AutomationTask 引用。
  // TODO: AutomationTask 增加 templateId 字段后，可实现"从模板创建任务"。
  // 当前阶段：模板为预设参考，未被任务系统自动引用。
}

model AIAgent {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  systemPrompt   String?
  promptTemplate String?                 // 客服prompt模板（兼容旧数据）
  replyStyle     String   @default("亲切")  // 亲切/专业/幽默
  welcomeMessage String?                // 欢迎语
  status      String   @default("active")
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User                    @relation(fields: [userId], references: [id])
  trainingDocuments TrainingDocument[]
}

model TrainingDocument {
  id        Int      @id @default(autoincrement())
  agentId   Int
  title     String
  type      String   @default("text")
  content   String?
  fileUrl   String?
  createdAt DateTime @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id])
}

model DigitalHumanTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  script      String?
  humanId     String?
  humanName   String?
  humanAvatar String?
  humanGender String?
  humanVoice  String?
  background  String?
  duration    Int      @default(30)
  thumbnail   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model NFCRuleTemplate {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  contentTitle  String?
  contentUrl    String?
  contentValue  String?
  nfcType       String?
  triggerType   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model PromptTemplate {
  id          Int      @id @default(autoincrement())
  title       String?
  prompt      String
  category    String?
  previewUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime?
  industry    String?
  originalUrl String?
  tags        String?   // 逗号分隔标签（2026-08-10 提示词库升级）
  author      String?   // 作者/来源社区
  coverUrl    String?   // 封面缩略图
  imageMode   String?   // generate / edit
  model       String?   // 2026-08-14 所属模型（Seedance 2.5 / MiniMax H3 / GPT-Image / 豆包 / FLUX 等）
  source      String?   // 2026-08-14 来源（cheerselfai / canvas.best / 自建）
  videoUrl    String?   // 2026-08-15 视频本体（OSS mp4，视频库用；卡片可播放）
  sourceKey   String?   // 来源标识（源名:hash 或 sourceId），用于去重
  published   Boolean   @default(false) // 是否已发布到用户素材库（2026-08-10，显式发布不乱推）
}

// 提示词源管理（2026-08-10：canvas.best 风格独立页 /admin/prompt-sources）
model PromptSource {
  id         Int      @id @default(autoincrement())
  name       String                       // 源名称
  url        String                       // JSON 拉取地址
  homepage   String?                      // 主页链接
  enabled    Boolean  @default(true)
  intervalMin Int     @default(30)         // 定时拉取间隔（分钟，0=不自动）
  lastSyncAt DateTime?                    // 上次成功时间
  lastStatus String   @default("never")   // never/success/error
  lastError  String?
  itemCount  Int      @default(0)          // 已入库条数
  builtIn    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 背景音乐库：精选免版税 BGM 转存 OSS 后入库，永久可用（避免原直链失效）
model BgmTrack {
  id         Int      @id @default(autoincrement())
  title      String                         // 风格名，如 "轻松愉快"
  mood       String?                        // 风格标签 uplifting / soft / electronic / cinematic
  duration   Int?                           // 时长（秒）
  url        String                         // OSS 永久地址
  sourceUrl  String?                        // 原始直链（留档）
  createdAt  DateTime @default(now())
}

// ====== V2 升级 - Phase 0-3 新增模型 ======
// 创建日期: 2026-06-06
// 用途: 支持导流系统、线索采集、直播模块

// ====== 导流系统模型 ======

// 1. 导流配置（替代 referral Stub API）
model ReferralConfig {
  id          Int      @id @default(autoincrement())
  name        String                        // 配置名称（如"抖音导流-美业"）
  platform    String   @default("抖音")     // 平台
  keywords    String                        // 目标关键词（JSON 数组）
  copyText    String?                       // 导流文案模板
  landingType String   @default("wechat")   // 落地方式: wechat/phone/link/miniapp
  landingValue String?                     // 落地内容（微信ID/手机号/链接）
  status      String   @default("draft")    // draft/active/paused/archived
  ownerId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id])
  logs        ReferralLog[]
}

// 2. 导流效果日志
model ReferralLog {
  id            Int      @id @default(autoincrement())
  configId      Int
  action        String                      // view/click/convert/contact
  sourceUser    String?                     // 来源用户 ID
  targetContent String?                     // 触达的内容
  metadata      String   @default("{}")     // 扩展字段 JSON
  createdAt     DateTime @default(now())

  config        ReferralConfig @relation(fields: [configId], references: [id])
}

// ====== 线索采集模型 ======

// 3. 线索（潜在客户信息）
model Lead {
  id            Int      @id @default(autoincrement())
  taskId        Int?                         // 关联的采集任务
  platform      String   @default("抖音")    // 来源平台
  sourceType    String   @default("comment") // comment/dm/search/keyword
  rawContent    String                       // 原始内容（评论/私信原文）
  contactInfo   String?                      // 提取的联系信息（手机/微信）
  intentScore   Float    @default(0)         // AI 打分 0-1（意向度）
  status        String   @default("new")     // new/contacted/converted/invalid
  tags          String?                      // 标签 JSON 数组
  metadata      String   @default("{}")     // 扩展字段
  ownerId       Int                           // 归属 editor
  assignedTo    Int?                          // 分配给 end-user
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  task          CollectionTask? @relation(fields: [taskId], references: [id])
  owner         User             @relation(fields: [ownerId], references: [id])
  assignee      User?            @relation("LeadAssignee", fields: [assignedTo], references: [id])
}

// 4. 采集任务
model CollectionTask {
  id          Int      @id @default(autoincrement())
  name        String
  platform    String   @default("抖音")
  keywords    String                        // 关键词 JSON 数组
  sources     String   @default("[]")       // 数据源配置
  schedule    String   @default("manual")   // manual/hourly/daily
  status      String   @default("active")   // active/paused/completed
  ownerId     Int
  leads       Lead[]
  crawledVideos CrawledVideo[]              // 关联采集到的视频
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])
}

// ====== 直播模块模型 ======

// 5. 直播间管理
model LiveRoom {
  id              Int      @id @default(autoincrement())
  name            String                        // 直播间名称
  platform        String   @default("抖音")      // 平台
  roomId          String?                       // 平台直播间 ID
  accountId       Int?                          // 使用的社交账号
  deviceId        Int?                          // 使用的 Q1 设备
  status          String   @default("offline")  // offline/live/reconnecting/ended
  title           String?                       // 直播标题
  coverImage      String?                       // 封面
  welcomeMessage  String?                       // 自动欢迎语
  autoReplyRules  String   @default("[]")       // 自动回复规则 JSON
  startTime       DateTime?
  endTime         DateTime?
  viewerCount     Int      @default(0)          // 当前观看人数
  totalViewers    Int      @default(0)          // 累计观众
  likeCount       Int      @default(0)          // 点赞数
  commentCount    Int      @default(0)          // 评论数
  productCount    Int      @default(0)          // 上架商品数
  ownerId         Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id])
  products        LiveProduct[]
  scripts         LiveScript[]
  logs            LiveLog[]
}

// 6. 直播商品
model LiveProduct {
  id          Int      @id @default(autoincrement())
  roomId      Int
  name        String                        // 商品名称
  price       Float?                        // 价格
  image       String?                       // 商品图 URL
  url         String?                       // 商品链接
  sortOrder   Int      @default(0)          // 排序
  status      String   @default("active")   // active/sold_out/removed
  createdAt   DateTime @default(now())

  room        LiveRoom @relation(fields: [roomId], references: [id])
}

// 7. 直播话术
model LiveScript {
  id          Int      @id @default(autoincrement())
  roomId      Int
  category    String   @default("welcome")  // welcome/product/intro/qa/close
  content     String                        // 话术内容
  triggerKeyword String?                    // 触发关键词
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  room        LiveRoom @relation(fields: [roomId], references: [id])
}

// 8. 直播日志
model LiveLog {
  id          Int      @id @default(autoincrement())
  roomId      Int
  eventType   String                       // start/end/viewer_join/comment/like/product_click
  payload     String   @default("{}")      // 事件数据 JSON
  createdAt   DateTime @default(now())

  room        LiveRoom @relation(fields: [roomId], references: [id])
}

// ====== 数据采集持久化模型 ======
// 创建日期: 2026-06-07
// 用途: 存储采集到的原始视频/评论/用户画像/热门话题数据

// 9. 爬取视频记录（搜索结果的持久化）
model CrawledVideo {
  id            Int      @id @default(autoincrement())
  taskId        Int?                          // 关联采集任务
  platform      String   @default("抖音")
  videoId       String                         // 平台视频唯一 ID (aweme_id)
  title         String                         // 视频/图文标题
  description   String?                        // 描述文字
  coverUrl      String?                        // 封面图 URL
  videoUrl      String?                        // 视频播放地址
  authorUid     String?                        // 作者 UID
  authorName    String?                        // 作者昵称
  authorAvatar  String?                        // 作者头像
  likeCount     Int      @default(0)
  commentCount  Int      @default(0)
  shareCount    Int      @default(0)
  collectCount  Int      @default(0)
  playCount     Int?                            // 播放数（部分可见）
  publishedAt   DateTime?                      // 发布时间
  tags          String?                         // 标签 JSON
  location      String?                        // 地理位置
  crawledAt     DateTime @default(now())        // 采集时间

  task          CollectionTask? @relation(fields: [taskId], references: [id])
  comments      CrawledComment[]

  @@unique([platform, videoId])  // 同一平台同一视频去重
}

// 10. 爬取评论记录（视频评论的持久化）
model CrawledComment {
  id            Int      @id @default(autoincrement())
  videoId       Int                            // 关联 CrawledVideo
  commentId     String                         // 平台评论唯一 ID
  content       String                         // 评论正文
  authorUid     String?                        // 评论者 UID
  authorName    String?                        // 评论者昵称
  authorAvatar  String?                        // 评论者头像
  likeCount     Int      @default(0)
  createdAt     DateTime?                      // 评论发布时间
  replyTo       String?                        // 回复的目标评论 ID
  isAuthorReply Boolean  @default(false)       // 是否作者回复
  crawledAt     DateTime @default(now())        // 采集时间
  intentScore   Float?                         // AI意向度（可选，分析后回填）
  leadId        Int?                           // 关联提取到的线索ID

  video         CrawledVideo  @relation(fields: [videoId], references: [id])
}

// 11. 用户画像记录
model CrawledUserProfile {
  id              Int      @id @default(autoincrement())
  uid             String                         // 平台用户 ID
  platform        String   @default("抖音")
  nickname        String
  avatar          String?
  bio             String?
  followerCount   Int      @default(0)
  followingCount  Int      @default(0)
  likeCount       Int      @default(0)
  videoCount      Int      @default(0)
  isVerified      Boolean  @default(false)
  verifyType      String?
  location        String?
  tags            String?
  firstCrawledAt  DateTime @default(now())
  lastCrawledAt   DateTime @updatedAt

  @@unique([uid, platform])  // 同一平台同一用户去重
}

// 12. 热门话题记录
model CrawledTrending {
  id            Int      @id @default(autoincrement())
  platform      String   @default("抖音")
  category      String                         // hot/daily/weekly
  title         String
  heatValue     Float?                          // 热度值
  description   String?
  coverUrl      String?
  rank          Int?                            // 排名
  crawledAt     DateTime @default(now())

  @@unique([platform, category, title])  // 去重
}

// ====== AGENT 长期记忆（融合 BaiLongma memory 模块，2026-08-02）======
model AgentMemory {
  id        Int      @id @default(autoincrement())
  userId    String                        // 归属用户（与 User.username 对应）
  content   String                        // 记忆内容
  tags      String   @default("")         // 逗号分隔标签
  salience  Float    @default(0.5)        // 重要度 0~1
  visibility String  @default("user")     // user / agent / all
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, salience])
}

// 13. 筛选方案（统一筛选器保存/复用）
model FilterPreset {
  id          Int      @id @default(autoincrement())
  name        String                         // "我的日常筛选"
  description String?
  entityType  String                         // "video" | "comment" | "lead" | "user" | "trending"
  filters     String                         // JSON: 筛选条件的序列化
  isDefault   Boolean  @default(false)       // 设为默认方案
  isShared    Boolean  @default(false)       // 团队共享
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [userId], references: [id])

  @@unique([userId, name, entityType])  // 同一用户同类型下名称唯一
}

// ====== 系统配置模型 ======
// 创建日期: 2026-06-09
// 用途: 存储系统全局配置，如客服联系方式、功能开关等

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique              // 配置键名 (service_phone / service_wechat / service_qrcode)
  value       String                        // 配置值
  label       String?                       // 显示名称 (如 "客服电话")
  description String?                       // 配置说明
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════════
// 脚本诊断报告 — DeepSeek AI 实时分析日志存储
// ═══════════════════════════════════════════════
model ScriptDiagnosis {
  id          Int      @id @default(autoincrement())
  app         String   @default("抖音")       // APP名称: 抖音/快手/小红书
  step        String                          // 出错的步骤: HOME_PLUS/SHOOT_ALBUM/...
  errorLog    String                          // 原始错误日志(截取关键片段)
  screenshot  String?                         // 截图文件名(存 /screenshots/)
  diagnosis   String                          // DeepSeek 诊断结果(Markdown)
  severity    String   @default("warning")    // warning / error / critical
  resolved    Boolean  @default(false)        // 是否已解决
  createdAt   DateTime @default(now())
  ownerId     Int?
}

// Agent 聊天会话 + 消息
model ChatSession {
  id        Int           @id @default(autoincrement())
  title     String        @default("新对话")
  userId    Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int
  role      String
  content   String
  toolUsed  Boolean     @default(false)
  intent    String?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ====== 生成记录总表 + 问题反馈 ======
// 创建日期: 2026-07-28
// 用途: 统一记录每笔 AI 生成的 平台 / 状态 / 消耗 / OSS落库地址，
//       杜绝"AI已生成但客户未收到"的投诉；后台查询替代服务器 grep 日志。

model GenerationRecord {
  id             Int      @id @default(autoincrement())
  userId         Int
  type           String                        // text2img / text2video / digital_human / voice_clone / ai_chat / analyze_video ...
  provider       String   @default("agnes")    // agnes / dashscope / volcano / edge-tts / openai ...
  model          String?                       // 具体模型名
  platformTaskId String?                       // AI 平台侧任务 id (如 agnes:ta...)
  status         String   @default("pending")  // pending / succeeded / failed
  costPoints     Int      @default(0)          // 成功时消耗的积分
  prompt         String?                       // 请求提示词(截断存储, 便于后台审计"执行了什么")
  platformUrl    String?                       // AI 平台返回的原始资源 URL
  storageUrl     String?                       // ★ 下载后存 OSS 的 URL (防投诉关键)
  sourceUrl      String?                       // 客户原始素材 URL (如有)
  errorMessage   String?                       // 失败原因
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
}

// 问题反馈（支持上传图片）
model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @default("问题")          // 问题 / 建议 / 投诉
  content   String                            // 反馈正文
  images    String?                           // 图片 URL 数组 (JSON)
  status    String   @default("待处理")        // 待处理 / 处理中 / 已解决 / 已关闭
  reply     String?                           // 官方回复
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

// 用户发布内容草稿箱（AI 生成/手填的标题文案话题封面，可保存后列表提取再发布）
// Agent 发布任务（C2 发布闭环：Agent 生成待发布任务，客户端 my-fingerprint 自动执行发布，复用 7 平台脚本）
model AgentPublishTask {
  id              Int      @id @default(autoincrement())
  userId          Int
  platform        String                       // douyin/xiaohongshu/kuaishou/bilibili/shipinhao/weibo
  socialAccountId Int?
  videoName       String                       // 素材仓库视频名（storageFileName）
  title           String
  description     String   @default("")
  topics          String   @default("[]")      // JSON 数组
  status          String   @default("pending") // pending/executing/succeeded/failed
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])

  @@index([userId, status])
}

model StoryboardTask {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String                       // 视频标题/主题
  topic       String                       // 创意描述
  ratio       String   @default("16:9")
  style       String?
  duration    Int      @default(30)         // 目标总时长
  shots       String                       // JSON：每镜 {shot,desc,prompt,duration,camera,status,videoUrl,error}
  status      String   @default("pending") // pending/generating/done/failed
  doneShots   Int      @default(0)
  totalShots  Int      @default(0)
  costPoints  Int      @default(0)          // 预估点数
  videoUrl    String?                      // 拼接成品 OSS
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}

model IndustryVideo {
  id        Int      @id @default(autoincrement())
  industry  String                       // 行业（餐饮/美业/教育…）
  title     String
  videoUrl  String                       // OSS 私有地址（签名访问）
  coverUrl  String?                      // FFmpeg 截取的首帧封面
  source    String   @default("youtube") // youtube/tiktok
  duration  Int?
  keyword   String?                      // 搜索关键词
  createdAt DateTime @default(now())

  @@index([industry, createdAt])
}

model ContentDraft {
  id          Int      @id @default(autoincrement())
  userId      Int
  platform    String                        // douyin/xiaohongshu/kuaishou/shipinhao/bilibili
  title       String
  description String   @default("")
  topics      String   @default("[]")        // JSON 数组字符串
  coverImage  String?
  videoName   String?                       // 关联的个人仓库视频（可选）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

