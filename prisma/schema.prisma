// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  username        String   @unique
  passwordHash    String
  name            String?
  role            String   @default("end-user") // admin / editor / end-user / viewer
  parentId        Int?                          // 上级ID：editor指向admin，end-user指向editor
  inviteCode      String?
  plan            String   @default("free")
  teamId          Int?
  isAgent         Boolean  @default(false)
  agentInviteCode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        Account[]
  videoTasks      VideoTask[]
  copyTasks       CopyTask[]
  publishingTasks PublishingTask[]
  dashboardStats  DashboardStat[]
  projects        Project[]
  createdInvites  InviteCode[]          @relation("InviteCodeCreator")
  usedInvite      InviteCode?           @relation("InviteCodeUsed")
  usageLogs       UsageLog[]
  teamMembers     TeamMember[]
  createdTeams    Team[]                @relation("TeamOwner")

  // 三层管理关联
  parent                  User?               @relation("UserParent", fields: [parentId], references: [id])
  children                User[]              @relation("UserParent")
  devicePools             DevicePool[]
  devices                 Device[]
  socialAccounts          SocialAccount[]
  submittedSubmissions    ContentSubmission[] @relation("Submitter")
  reviewedSubmissions     ContentSubmission[] @relation("Reviewer")
  createdTasks            AutomationTask[]
  poiAddresses            PoiAddress[]
  scriptTemplates         ScriptTemplate[]
  accountGroups           AccountGroup[]
  mediaAssets             MediaAsset[]
  automationTemplates     AutomationTemplate[]
  copyTemplates           CopyTemplate[]
  aiAgents                AIAgent[]
  phyDevices              PhyDevice[]
  taskConfigs             TaskConfig[]
  
  // V2 升级新增关系 (Phase 0-3)
  referrals               ReferralConfig[]
  leads                   Lead[]
  assignedLeads           Lead[]                @relation("LeadAssignee")
  collectionTasks         CollectionTask[]
  liveRooms               LiveRoom[]
}

model DevicePool {
  id           Int      @id @default(autoincrement())
  ownerId      Int                           // 所属二级客户 (editor)
  totalWindows Int      @default(0)          // 总窗口配额（一共可用多少个窗口）
  usedWindows  Int      @default(0)          // 已绑定账号的窗口数
  dailyQuota   Int      @default(12)         // 每日可刷新窗口数（Q1单次12个，关窗后可再开一批）
  createdAt    DateTime @default(now())

  owner    User            @relation(fields: [ownerId], references: [id])
  sessions WindowSession[]
}
// 窗口使用记录：Q1多窗口可后续查询分析
model WindowSession {
  id        Int      @id @default(autoincrement())
  poolId    Int                           // 关联的 DevicePool
  deviceId  Int?                          // 关联的物理Q1设备
  status    String   @default("active")   // active(进行中) / closed(已关闭) / expired(超时)
  openedAt  DateTime @default(now())      // 窗口开启时间
  closedAt  DateTime?                     // 窗口关闭时间
  taskCount Int      @default(0)          // 此窗口执行了多少个任务
  note      String?                       // 备注（绑定的账号、执行内容等）

  pool   DevicePool @relation(fields: [poolId], references: [id])
  device Device?    @relation(fields: [deviceId], references: [id])
}

model Device {
  id            Int      @id @default(autoincrement())
  name          String
  status        String   @default("offline") // online / offline / busy
  lastHeartbeat DateTime @default(now())
  groupId       String?
  ownerId       Int
  ip            String?  // Q1容器IP
  apiPort       Int?     // 安卓管理API端口
  rpaPort       Int?     // RPA触控端口
  adbPort       Int?     // ADB端口
  type          String   @default("mock") // "mock" | "q1"
  phyDeviceName String?                    // Q1物理机名称，多窗口共享同一台Q1时相同
  phyDeviceId   Int?                       // 关联的 Q1 物理机
  createdAt     DateTime @default(now())

  owner           User              @relation(fields: [ownerId], references: [id])
  phyDevice       PhyDevice?        @relation(fields: [phyDeviceId], references: [id])
  accounts        Account[]
  socialAccounts  SocialAccount[]
  automationTasks AutomationTask[]
  windowSessions  WindowSession[]
}

// Q1 物理机，一台 Q1 设备对应多条 Device 容器记录
model PhyDevice {
  id        Int      @id @default(autoincrement())
  name      String                       // 如 "办公室Q1"
  ip        String                       // 192.168.1.14
  port      Int      @default(8000)      // 管理端口
  note      String?                      // 备注
  status    String   @default("online")  // online / offline
  ownerId   Int                          // 管理员 ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  devices Device[]
}

model SocialAccount {
  id        Int      @id @default(autoincrement())
  platform  String                       // 抖音/快手/小红书等
  username  String
  password  String                       // 加密存储
  deviceId  Int?
  userId    Int
  status    String   @default("未绑定")   // 未绑定/已绑定/已封禁
  createdAt DateTime @default(now())

  user            User              @relation(fields: [userId], references: [id])
  device          Device?           @relation(fields: [deviceId], references: [id])
  accountGroupItems AccountGroupItem[]
  publishingTasks   PublishingTask[]
}

model ContentSubmission {
  id             Int      @id @default(autoincrement())
  videoUrl       String                       // OSS地址
  caption        String                       // 文案标题
  targetPlatform String
  status         String   @default("待审核")   // 待审核/已通过/已拒绝/已发布
  submitterId    Int
  reviewerId     Int?
  createdAt      DateTime @default(now())

  submitter User  @relation("Submitter", fields: [submitterId], references: [id])
  reviewer  User? @relation("Reviewer", fields: [reviewerId], references: [id])
}

model AutomationTask {
  id               Int      @id @default(autoincrement())
  type             String                       // 互关/点赞/评论/转发/发布视频
  status           String   @default("等待中")    // 等待中/执行中/已完成/失败
  params           String   @default("{}")       // JSON
  assignedDeviceId Int?
  createdBy        Int
  createdAt        DateTime @default(now())

  device      Device?    @relation(fields: [assignedDeviceId], references: [id])
  creator     User       @relation(fields: [createdBy], references: [id])
  taskLogs    TaskLog[]
}

model TaskLog {
  id           Int      @id @default(autoincrement())
  taskId       Int
  action       String
  result       String
  errorMessage String?
  createdAt    DateTime @default(now())

  task AutomationTask @relation(fields: [taskId], references: [id])
}

// 每账号每设备独立任务配置
model TaskConfig {
  id          Int      @id @default(autoincrement())
  accountId   Int
  deviceId    Int?
  platform    String
  keywords    String   @default("[]")     // ["火锅","美业","减肥"]
  timeStart   String   @default("09:00")
  timeEnd     String   @default("23:00")
  actions     String   @default("[]")     // ["search","like","comment","follow","dm"]
  leadGen     String   @default("{}")     // 获客配置（预留）
  isActive    Boolean  @default(true)
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id])
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())

  owner     User          @relation("TeamOwner", fields: [ownerId], references: [id])
  members   TeamMember[]
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    Int
  role      String   @default("viewer")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Account {
  id          Int      @id @default(autoincrement())
  platform    String
  accountId   String
  accountName String
  isBound     Boolean  @default(false)
  bindType    String   @default("device")  // device(真机群控) / manual(指纹浏览器) / official(官方API)
  password    String   @default("")
  mobile      String   @default("")          // 手机号（绑定用）
  deviceId    Int?                           // 绑定的设备
  status      String   @default("未绑定")    // 未绑定/已绑定/登录异常/已封禁
  remark      String   @default("")
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  device          Device?          @relation(fields: [deviceId], references: [id])
  publishingTasks PublishingTask[]
}

model VideoTask {
  id           Int      @id @default(autoincrement())
  userId       Int
  originalFile String
  template     String
  duration     Int
  style        String
  status       String
  outputPath   String?
  progress     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  publishingTasks PublishingTask[]
}

model CopyTask {
  id         Int      @id @default(autoincrement())
  userId     Int
  keywords   String
  platform   String
  style      String
  result     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PublishingTask {
  id              Int      @id @default(autoincrement())
  userId          Int
  accountId       Int
  socialAccountId Int?
  videoTaskId     Int
  publishTime     DateTime?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  account       Account       @relation(fields: [accountId], references: [id])
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])
  videoTask     VideoTask     @relation(fields: [videoTaskId], references: [id])
}

model DashboardStat {
  id              Int      @id @default(autoincrement())
  userId          Int
  date            DateTime @default(now())
  platform        String   @default("抖音")
  followers       Int      @default(0)
  publishCount    Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  engagementRate  Float    @default(0)

  user User @relation(fields: [userId], references: [id])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("active")
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model InviteCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  role      String
  usedBy    Int?     @unique
  createdBy Int
  isActive  Boolean  @default(true)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?

  usedByUser User?  @relation("InviteCodeUsed", fields: [usedBy], references: [id])
  creator    User   @relation("InviteCodeCreator", fields: [createdBy], references: [id])
}

model UsageLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String   // "ai_copy" / "ai_image" / "video_edit" / "ai_chat" / "text_to_video" / "digital_human"
  count     Int      @default(1)
  tokens    Int?     // AI消耗的token数（如使用AI文案/AI生图等）
  model     String?  // 使用的AI模型名称（如 GPT-4o / Qwen / StableDiffusion）
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  // 【AI工具使用统计】
  // 此表记录所有AI功能的使用情况，包括：
  // - action: 功能类型（ai_copy=文案, ai_image=生图, video_edit=剪辑, etc.）
  // - tokens: 每次调用的token消耗（用于统计成本）
  // - model: 使用的模型（用于区分不同模型成本）
  // Dashboard 通过此表计算：总使用量、Token消耗、各功能使用分布
}

model VideoTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  prompt      String
  duration    Int      @default(30)
  style       String
  thumbnail   String?
  videoUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // 【视频模板】
  // 预置视频编辑模板，用于快速生成视频。
  // 前端/AI通过此表获取可用模板列表。
}

model CopyTemplate {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  platform  String   @default("抖音")
  style     String   @default("种草")
  tags      String?                       // JSON 数组
  status    String   @default("pending")  // pending / approved / rejected
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PoiAddress {
  id         Int      @id @default(autoincrement())
  name       String
  platform   String   @default("抖音")
  address    String
  lat        Float
  lng        Float
  category   String?
  status     String   @default("active")
  ownerId    Int
  createdAt  DateTime @default(now())

  owner      User              @relation(fields: [ownerId], references: [id])
}

model ScriptTemplate {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  platform  String   @default("抖音")
  type      String?
  tags      String?                    // JSON 数组
  ownerId   Int
  createdAt DateTime @default(now())

  owner           User              @relation(fields: [ownerId], references: [id])
}

model AccountGroup {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())

  owner  User               @relation(fields: [ownerId], references: [id])
  items  AccountGroupItem[]
}

model AccountGroupItem {
  id              Int      @id @default(autoincrement())
  groupId         Int
  socialAccountId Int
  createdAt       DateTime @default(now())

  group         AccountGroup  @relation(fields: [groupId], references: [id])
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])

  @@unique([groupId, socialAccountId])
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  title     String
  url       String?
  type      String   @default("video")  // video / image / audio
  duration  Int?
  size      Int?
  ownerId   Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  // 【素材库】
  // 存放上传的视频/图片/音频素材，供AI调用于视频合成。
}

model AutomationTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   // 互关/点赞/评论/转发/发布视频
  params    String   @default("{}") // JSON
  ownerId   Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  // 【自动化任务模板】
  // 预设任务模板，可被 AutomationTask 引用。
  // TODO: AutomationTask 增加 templateId 字段后，可实现"从模板创建任务"。
  // 当前阶段：模板为预设参考，未被任务系统自动引用。
}

model AIAgent {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  systemPrompt   String?
  promptTemplate String?                 // 客服prompt模板（兼容旧数据）
  replyStyle     String   @default("亲切")  // 亲切/专业/幽默
  welcomeMessage String?                // 欢迎语
  status      String   @default("active")
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User                    @relation(fields: [userId], references: [id])
  trainingDocuments TrainingDocument[]
}

model TrainingDocument {
  id        Int      @id @default(autoincrement())
  agentId   Int
  title     String
  type      String   @default("text")
  content   String?
  fileUrl   String?
  createdAt DateTime @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id])
}

model DigitalHumanTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  script      String?
  humanId     String?
  humanName   String?
  humanAvatar String?
  humanGender String?
  humanVoice  String?
  background  String?
  duration    Int      @default(30)
  thumbnail   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model NFCRuleTemplate {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  contentTitle  String?
  contentUrl    String?
  contentValue  String?
  nfcType       String?
  triggerType   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model PromptTemplate {
  id       Int      @id @default(autoincrement())
  title    String?
  prompt   String
  category String?
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ====== V2 升级 - Phase 0-3 新增模型 ======
// 创建日期: 2026-06-06
// 用途: 支持导流系统、线索采集、直播模块

// ====== 导流系统模型 ======

// 1. 导流配置（替代 referral Stub API）
model ReferralConfig {
  id          Int      @id @default(autoincrement())
  name        String                        // 配置名称（如"抖音导流-美业"）
  platform    String   @default("抖音")     // 平台
  keywords    String                        // 目标关键词（JSON 数组）
  copyText    String?                       // 导流文案模板
  landingType String   @default("wechat")   // 落地方式: wechat/phone/link/miniapp
  landingValue String?                     // 落地内容（微信ID/手机号/链接）
  status      String   @default("draft")    // draft/active/paused/archived
  ownerId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id])
  logs        ReferralLog[]
}

// 2. 导流效果日志
model ReferralLog {
  id            Int      @id @default(autoincrement())
  configId      Int
  action        String                      // view/click/convert/contact
  sourceUser    String?                     // 来源用户 ID
  targetContent String?                     // 触达的内容
  metadata      String   @default("{}")     // 扩展字段 JSON
  createdAt     DateTime @default(now())

  config        ReferralConfig @relation(fields: [configId], references: [id])
}

// ====== 线索采集模型 ======

// 3. 线索（潜在客户信息）
model Lead {
  id            Int      @id @default(autoincrement())
  taskId        Int?                         // 关联的采集任务
  platform      String   @default("抖音")    // 来源平台
  sourceType    String   @default("comment") // comment/dm/search/keyword
  rawContent    String                       // 原始内容（评论/私信原文）
  contactInfo   String?                      // 提取的联系信息（手机/微信）
  intentScore   Float    @default(0)         // AI 打分 0-1（意向度）
  status        String   @default("new")     // new/contacted/converted/invalid
  tags          String?                      // 标签 JSON 数组
  metadata      String   @default("{}")     // 扩展字段
  ownerId       Int                           // 归属 editor
  assignedTo    Int?                          // 分配给 end-user
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  task          CollectionTask? @relation(fields: [taskId], references: [id])
  owner         User             @relation(fields: [ownerId], references: [id])
  assignee      User?            @relation("LeadAssignee", fields: [assignedTo], references: [id])
}

// 4. 采集任务
model CollectionTask {
  id          Int      @id @default(autoincrement())
  name        String
  platform    String   @default("抖音")
  keywords    String                        // 关键词 JSON 数组
  sources     String   @default("[]")       // 数据源配置
  schedule    String   @default("manual")   // manual/hourly/daily
  status      String   @default("active")   // active/paused/completed
  ownerId     Int
  leads       Lead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])
}

// ====== 直播模块模型 ======

// 5. 直播间管理
model LiveRoom {
  id              Int      @id @default(autoincrement())
  name            String                        // 直播间名称
  platform        String   @default("抖音")      // 平台
  roomId          String?                       // 平台直播间 ID
  accountId       Int?                          // 使用的社交账号
  deviceId        Int?                          // 使用的 Q1 设备
  status          String   @default("offline")  // offline/live/reconnecting/ended
  title           String?                       // 直播标题
  coverImage      String?                       // 封面
  welcomeMessage  String?                       // 自动欢迎语
  autoReplyRules  String   @default("[]")       // 自动回复规则 JSON
  startTime       DateTime?
  endTime         DateTime?
  viewerCount     Int      @default(0)          // 当前观看人数
  totalViewers    Int      @default(0)          // 累计观众
  likeCount       Int      @default(0)          // 点赞数
  commentCount    Int      @default(0)          // 评论数
  productCount    Int      @default(0)          // 上架商品数
  ownerId         Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id])
  products        LiveProduct[]
  scripts         LiveScript[]
  logs            LiveLog[]
}

// 6. 直播商品
model LiveProduct {
  id          Int      @id @default(autoincrement())
  roomId      Int
  name        String                        // 商品名称
  price       Float?                        // 价格
  image       String?                       // 商品图 URL
  url         String?                       // 商品链接
  sortOrder   Int      @default(0)          // 排序
  status      String   @default("active")   // active/sold_out/removed
  createdAt   DateTime @default(now())

  room        LiveRoom @relation(fields: [roomId], references: [id])
}

// 7. 直播话术
model LiveScript {
  id          Int      @id @default(autoincrement())
  roomId      Int
  category    String   @default("welcome")  // welcome/product/intro/qa/close
  content     String                        // 话术内容
  triggerKeyword String?                    // 触发关键词
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  room        LiveRoom @relation(fields: [roomId], references: [id])
}

// 8. 直播日志
model LiveLog {
  id          Int      @id @default(autoincrement())
  roomId      Int
  eventType   String                       // start/end/viewer_join/comment/like/product_click
  payload     String   @default("{}")      // 事件数据 JSON
  createdAt   DateTime @default(now())

  room        LiveRoom @relation(fields: [roomId], references: [id])
}
