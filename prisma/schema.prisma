// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  username        String   @unique
  passwordHash    String
  name            String?
  role            String   @default("viewer") // admin / editor / end-user / viewer
  parentId        Int?                          // 上级ID：editor指向admin，end-user指向editor
  inviteCode      String?
  plan            String   @default("free")
  teamId          Int?
  isAgent         Boolean  @default(false)
  agentInviteCode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        Account[]
  videoTasks      VideoTask[]
  copyTasks       CopyTask[]
  publishingTasks PublishingTask[]
  dashboardStats  DashboardStat[]
  projects        Project[]
  createdInvites  InviteCode[]          @relation("InviteCodeCreator")
  usedInvite      InviteCode?           @relation("InviteCodeUsed")
  usageLogs       UsageLog[]
  teamMembers     TeamMember[]
  createdTeams    Team[]                @relation("TeamOwner")

  // 三层管理关联
  parent                  User?               @relation("UserParent", fields: [parentId], references: [id])
  children                User[]              @relation("UserParent")
  devicePools             DevicePool[]
  devices                 Device[]
  socialAccounts          SocialAccount[]
  submittedSubmissions    ContentSubmission[] @relation("Submitter")
  reviewedSubmissions     ContentSubmission[] @relation("Reviewer")
  createdTasks            AutomationTask[]
  poiAddresses            PoiAddress[]
  scriptTemplates         ScriptTemplate[]
  accountGroups           AccountGroup[]
  mediaAssets             MediaAsset[]
  automationTemplates     AutomationTemplate[]
  copyTemplates           CopyTemplate[]
}

model DevicePool {
  id           Int      @id @default(autoincrement())
  ownerId      Int                           // 所属二级客户
  totalWindows Int      @default(0)
  usedWindows  Int      @default(0)
  createdAt    DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])
}

model Device {
  id            Int      @id @default(autoincrement())
  name          String
  status        String   @default("offline") // online / offline / busy
  lastHeartbeat DateTime @default(now())
  groupId       String?
  ownerId       Int
  ip            String?  // Q1容器IP
  apiPort       Int?     // 安卓管理API端口
  rpaPort       Int?     // RPA触控端口
  adbPort       Int?     // ADB端口
  type          String   @default("mock") // "mock" | "q1"
  createdAt     DateTime @default(now())

  owner           User              @relation(fields: [ownerId], references: [id])
  socialAccounts  SocialAccount[]
  automationTasks AutomationTask[]
}

model SocialAccount {
  id        Int      @id @default(autoincrement())
  platform  String                       // 抖音/快手/小红书等
  username  String
  password  String                       // 加密存储
  deviceId  Int?
  userId    Int
  status    String   @default("未绑定")   // 未绑定/已绑定/已封禁
  createdAt DateTime @default(now())

  user            User              @relation(fields: [userId], references: [id])
  device          Device?           @relation(fields: [deviceId], references: [id])
  accountGroupItems AccountGroupItem[]
  publishingTasks   PublishingTask[]
}

model ContentSubmission {
  id             Int      @id @default(autoincrement())
  videoUrl       String                       // OSS地址
  caption        String                       // 文案标题
  targetPlatform String
  status         String   @default("待审核")   // 待审核/已通过/已拒绝/已发布
  submitterId    Int
  reviewerId     Int?
  createdAt      DateTime @default(now())

  submitter User  @relation("Submitter", fields: [submitterId], references: [id])
  reviewer  User? @relation("Reviewer", fields: [reviewerId], references: [id])
}

model AutomationTask {
  id               Int      @id @default(autoincrement())
  type             String                       // 互关/点赞/评论/转发/发布视频
  status           String   @default("等待中")    // 等待中/执行中/已完成/失败
  params           String   @default("{}")       // JSON
  assignedDeviceId Int?
  createdBy        Int
  createdAt        DateTime @default(now())

  device      Device?    @relation(fields: [assignedDeviceId], references: [id])
  creator     User       @relation(fields: [createdBy], references: [id])
  taskLogs    TaskLog[]
}

model TaskLog {
  id           Int      @id @default(autoincrement())
  taskId       Int
  action       String
  result       String
  errorMessage String?
  createdAt    DateTime @default(now())

  task AutomationTask @relation(fields: [taskId], references: [id])
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())

  owner     User          @relation("TeamOwner", fields: [ownerId], references: [id])
  members   TeamMember[]
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    Int
  role      String   @default("viewer")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Account {
  id          Int      @id @default(autoincrement())
  platform    String
  accountId   String
  accountName String
  isBound     Boolean  @default(false)
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  publishingTasks PublishingTask[]
}

model VideoTask {
  id           Int      @id @default(autoincrement())
  userId       Int
  originalFile String
  template     String
  duration     Int
  style        String
  status       String
  outputPath   String?
  progress     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  publishingTasks PublishingTask[]
}

model CopyTask {
  id         Int      @id @default(autoincrement())
  userId     Int
  keywords   String
  platform   String
  style      String
  resultJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model PublishingTask {
  id              Int       @id @default(autoincrement())
  userId          Int
  accountId       Int
  socialAccountId Int?                          // 关联 SocialAccount，桥接设备+分组系统
  videoTaskId     Int
  publishTime     DateTime?
  status          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  account       Account       @relation(fields: [accountId], references: [id])
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])
  videoTask     VideoTask     @relation(fields: [videoTaskId], references: [id])
}

model DashboardStat {
  id             Int      @id @default(autoincrement())
  userId         Int
  platform       String
  followers      Int      @default(0)
  publishCount   Int      @default(0)
  engagementRate Float    @default(0)
  date           DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AIAgent {
  id             Int      @id @default(autoincrement())
  name           String
  welcomeMessage String
  replyStyle     String
  promptTemplate String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trainingDocuments TrainingDocument[]
}

model TrainingDocument {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  type      String
  agentId   Int
  createdAt DateTime @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  userId      Int
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  assets Asset[]
}

model Asset {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileType  String
  content   String?
  url       String?
  projectId Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model InviteCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  createdBy Int
  role      String   @default("editor") // editor 或 end-user
  isUsed    Boolean  @default(false)
  isActive  Boolean  @default(true)
  usedBy    Int?     @unique
  createdAt DateTime @default(now())

  creator User   @relation("InviteCodeCreator", fields: [createdBy], references: [id])
  user    User?  @relation("InviteCodeUsed", fields: [usedBy], references: [id])
}

model UsageLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  count     Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// 视频生成模板
model VideoTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  prompt      String
  duration    Int      @default(30)
  style       String
  thumbnail   String?
  videoUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 数字人模板
model DigitalHumanTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  script      String?
  humanId     Int?
  humanName   String?
  humanAvatar String?
  humanGender String?
  humanVoice  String?
  background  String?
  duration    Int      @default(30)
  thumbnail   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// NFC推广规则模板
model NFCRuleTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  triggerType  String
  description  String?
  contentTitle String?
  contentUrl   String?
  contentValue String?
  isActive     Boolean  @default(true)       // true=启用, false=禁用 (已合并原status字段)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 文案模板
model CopyTemplate {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  platform  String
  style     String?
  tags      String?
  status    String    @default("pending") // pending=待审核, approved=已通过, rejected=已拒绝
  userId    Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

// POI 地址库
model PoiAddress {
  id       Int    @id @default(autoincrement())
  name     String
  address  String
  lat      Float
  lng      Float
  platform String
  ownerId  Int

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

// 话术模板
model ScriptTemplate {
  id        Int      @id @default(autoincrement())
  title     String
  type      String   // 评论/私信/直播互动
  content   String
  tags      String   @default("[]") // JSON
  ownerId   Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

// 账号分组
model AccountGroup {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())

  owner User              @relation(fields: [ownerId], references: [id])
  items AccountGroupItem[]

  @@index([ownerId])
}

// 账号分组条目
model AccountGroupItem {
  id        Int          @id @default(autoincrement())
  groupId   Int
  accountId Int

  group   AccountGroup  @relation(fields: [groupId], references: [id])
  account SocialAccount @relation(fields: [accountId], references: [id])

  @@unique([groupId, accountId])
}

// 视频素材库
model MediaAsset {
  id        Int      @id @default(autoincrement())
  ossUrl    String
  title     String
  prompt    String   @default("")
  type      String   @default("video")
  category  String   @default("")
  source    String   @default("public")
  ownerId   Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

// 自动化任务模板
model AutomationTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   // 互关/点赞/评论/转发/发布视频
  params    String   @default("{}") // JSON
  ownerId   Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

// 提示词模板库
model PromptTemplate {
  id         Int      @id @default(autoincrement())
  title      String
  category   String   // 海报封面/产品展示/品牌宣传/节日营销/短视频封面
  prompt     String
  previewUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}