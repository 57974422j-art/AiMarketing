{
  "appId": "com.aimarketing.app",
  "productName": "AI营销助手",
  "directories": {
    "output": "dist-rel"
  },
  "files": [
    ".next/**/*",
    "electron/**/*",
    "public/**/*",
    "!public/updates/**",
    "package.json"
  ],
  "asarUnpack": [
    "**/*.node",
    "**/*.exe",
    "**/*.dll",
    "**/node_modules/@jackwener/opencli/**",
    "node_modules/@jackwener/opencli/**"
  ],
  "extraResources": [
    {
      "from": "scripts/platform-tools",
      "to": "scripts/platform-tools"
    },
    {
      "from": "scripts/browser-use",
      "to": "scripts/browser-use",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "scripts/scrcpy",
      "to": "scripts/scrcpy"
    },
    {
      "from": "C:/Users/wo'shen/AppData/Local/ms-playwright",
      "to": "ms-playwright",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "electron/models/sherpa",
      "to": "models/sherpa",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "electron/resources/opencli-extension",
      "to": "opencli-extension",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "public/icon.png",
    "artifactName": "AI-Marketing-Setup-${version}.exe"
  },
  "publish": {
    "provider": "generic",
    "url": "https://ai-niuma.cc/updates"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "include": "electron/installer.nsh"
  }
}