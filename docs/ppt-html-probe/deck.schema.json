{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimarketing.local/schema/deck.schema.json",
  "title": "HTML 动态 PPT · 分页契约 v1 (deck.schema.json)",
  "description": "AI 只输出本 schema 的 JSON，不写 HTML/CSS。内容量下限写死在约束里（要点 >=3 条且每条 >=8 字、数据页必须有 数字+单位+解释、封面必须有 主标题+副标）。字符数均指 Python/JS 意义下的字符个数（去首尾空白后按 码点 计）。",
  "type": "object",
  "required": ["version", "meta", "style", "pages"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0",
      "description": "契约版本；母版升级时同步升这里"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "style": {
      "$ref": "#/$defs/style"
    },
    "pages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "description": "第 1 页必须是 cover（用 meta 的标题/副标渲染）；建议最后 1 页是 end。",
      "prefixItems": [{ "$ref": "#/$defs/pageCover" }],
      "items": { "$ref": "#/$defs/pageAny" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["title", "subtitle", "lang"],
      "additionalProperties": false,
      "description": "封面主标题 + 副标（硬性），出品方/日期可选",
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 40, "description": "封面主标题（硬性 ≥4 字）" },
        "subtitle": { "type": "string", "minLength": 6, "maxLength": 60, "description": "封面副标（硬性 ≥6 字）" },
        "issuer": { "type": "string", "maxLength": 40, "description": "出品方（右下/左下小字，可选）" },
        "date": { "type": "string", "maxLength": 24, "description": "日期/期号小字，可选" },
        "lang": { "enum": ["zh-CN"], "description": "v1 只支持简体中文" }
      }
    },
    "style": {
      "type": "object",
      "required": ["masterId", "palette", "density", "tempo", "orientation"],
      "additionalProperties": false,
      "description": "风格参数只允许在这四组枚举里选，不许自由发挥",
      "properties": {
        "masterId": { "enum": ["master-v1", "master-v2"], "description": "母版 ID（枚举；决定版式/皮肤/几何/动效语言，资产在 masters/<id>/）" },
        "palette": { "enum": ["warm-gold", "olive", "clay", "mist-blue"], "description": "配色方案（低饱和，一次只用 1 个强调色）" },
        "density": { "enum": ["airy", "normal", "dense"], "description": "信息密度（影响版心与行距）" },
        "tempo": { "enum": ["calm", "normal", "brisk"], "description": "节奏（映射 --enter/--enter-gap/--xover）" },
        "orientation": { "enum": ["16:9", "9:16"], "description": "画布比例" }
      }
    },
    "pageAny": {
      "oneOf": [
        { "$ref": "#/$defs/pageCover" },
        { "$ref": "#/$defs/pageBullets" },
        { "$ref": "#/$defs/pageData" },
        { "$ref": "#/$defs/pageEnd" },
        { "$ref": "#/$defs/pageSection" },
        { "$ref": "#/$defs/pageChart" },
        { "$ref": "#/$defs/pageCompare" },
        { "$ref": "#/$defs/pageQuote" },
        { "$ref": "#/$defs/pageToc" },
        { "$ref": "#/$defs/pageSummary" }
      ]
    },
    "pageCover": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "封面：内容全部来自 meta.title / meta.subtitle（硬性），本页不重复写文案",
      "properties": {
        "type": { "const": "cover" },
        "kicker": { "type": "string", "maxLength": 32, "description": "眉标小字，如 AIMARKETING · 视频工厂" },
        "asset": { "type": "string", "description": "封面素材在项目内的相对路径（必须已拷进项目，禁 file://）" }
      }
    },
    "pageBullets": {
      "type": "object",
      "required": ["type", "title", "items", "summary"],
      "additionalProperties": false,
      "description": "要点页：3~5 条编号要点，每条 >=8 字，底部一句小结",
      "properties": {
        "type": { "const": "bullets" },
        "title": { "type": "string", "minLength": 4, "maxLength": 24 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 8, "maxLength": 40, "description": "每条要点 >=8 字" }
        },
        "summary": { "type": "string", "minLength": 6, "maxLength": 40, "description": "底部一句小结（硬性）" }
      }
    },
    "pageData": {
      "type": "object",
      "required": ["type", "title", "metric", "secondary"],
      "additionalProperties": false,
      "description": "数据页：必须有 数字+单位+解释，外加 2 个次要指标",
      "properties": {
        "type": { "const": "data" },
        "title": { "type": "string", "minLength": 4, "maxLength": 24 },
        "metric": {
          "type": "object",
          "required": ["number", "unit", "explain"],
          "additionalProperties": false,
          "properties": {
            "number": { "type": "number", "description": "大数字（硬性，必须是真实数字，不许编）" },
            "unit": { "type": "string", "minLength": 1, "maxLength": 8, "description": "单位，如 ms / 帧、%、元" },
            "explain": { "type": "string", "minLength": 8, "maxLength": 60, "description": "一句解释（硬性 >=8 字）" }
          }
        },
        "secondary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "恰好 2 个次要指标（小字）",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 2, "maxLength": 20, "description": "次要指标键（小字加粗）" },
              "note": { "type": "string", "maxLength": 30, "description": "次要指标补充说明（更小字，可选）" }
            }
          }
        }
      }
    },
    "pageEnd": {
      "type": "object",
      "required": ["type", "line1", "cta", "en"],
      "additionalProperties": false,
      "description": "尾页：主句（可 2 行）+ CTA + 一行英文",
      "properties": {
        "type": { "const": "end" },
        "line1": { "type": "string", "minLength": 4, "maxLength": 30, "description": "主句第一行" },
        "line2": { "type": "string", "maxLength": 30, "description": "主句第二行（可选）" },
        "cta": { "type": "string", "minLength": 6, "maxLength": 40, "description": "行动号召（硬性）" },
        "en": { "type": "string", "minLength": 6, "maxLength": 60, "description": "一行英文（小字，硬性）" }
      }
    },
    "pageSection": {
      "type": "object",
      "required": ["type", "title"],
      "additionalProperties": false,
      "description": "章节页：title 硬性（不许只有编号）",
      "properties": {
        "type": { "const": "section" },
        "number": { "type": "string", "maxLength": 12, "description": "第几章（可选，如 01 / 第二章）" },
        "title": { "type": "string", "minLength": 4, "maxLength": 24, "description": "章节标题（硬性 ≥4 字）" },
        "subtitle": { "type": "string", "minLength": 6, "maxLength": 40, "description": "一句副题（可选；给了就要 ≥6 字）" }
      }
    },
    "pageChart": {
      "type": "object",
      "required": ["type", "title", "chart", "unit", "explain"],
      "additionalProperties": false,
      "description": "图表页：真画图。series ≥4 个数据点且必须是 number（沿\"不许编数字\"闸门）",
      "properties": {
        "type": { "const": "chart" },
        "title": { "type": "string", "minLength": 4, "maxLength": 24 },
        "chart": {
          "type": "object",
          "required": ["type", "series"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["line", "bar", "donut"], "description": "折线 / 柱 / 占比环" },
            "series": {
              "type": "array",
              "minItems": 4,
              "maxItems": 12,
              "items": { "type": "number", "description": "数据点必须是 number（硬性）" },
              "description": "≥4 个数据点；图上画出的点数必须等于这里"
            },
            "labels": {
              "type": "array",
              "maxItems": 12,
              "items": { "type": "string", "maxLength": 10 },
              "description": "横轴标签（可选；若给，条数应与 series 一致）"
            }
          }
        },
        "unit": { "type": "string", "minLength": 1, "maxLength": 8, "description": "单位，如 % / 秒 / 万" },
        "explain": { "type": "string", "minLength": 8, "maxLength": 60, "description": "一句解释（硬性 ≥8 字）" },
        "source": { "type": "string", "maxLength": 40, "description": "数据来源（可选，右下小字）" }
      }
    },
    "compareSide": {
      "type": "object",
      "required": ["label", "points"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 2, "maxLength": 12 },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 6, "maxLength": 28 },
          "description": "2~4 条，每条 ≥6 字"
        }
      }
    },
    "pageCompare": {
      "type": "object",
      "required": ["type", "title", "left", "right", "conclusion"],
      "additionalProperties": false,
      "description": "对比页：左右各 2~4 条（每条 ≥6 字）+ 一句结论（≥8 字）",
      "properties": {
        "type": { "const": "compare" },
        "title": { "type": "string", "minLength": 4, "maxLength": 24 },
        "left": { "$ref": "#/$defs/compareSide" },
        "right": { "$ref": "#/$defs/compareSide" },
        "conclusion": { "type": "string", "minLength": 8, "maxLength": 40, "description": "一句结论（硬性 ≥8 字）" }
      }
    },
    "pageQuote": {
      "type": "object",
      "required": ["type", "quote"],
      "additionalProperties": false,
      "description": "引用页：quote ≥12 字且必须是一句完整的话（以 。！？… 收尾），不是名词短语",
      "properties": {
        "type": { "const": "quote" },
        "quote": { "type": "string", "minLength": 12, "maxLength": 80 },
        "author": { "type": "string", "minLength": 2, "maxLength": 20, "description": "出处/作者（可选）" },
        "context": { "type": "string", "maxLength": 40, "description": "出处补充（可选，更小字）" }
      }
    },
    "pageToc": {
      "type": "object",
      "required": ["type", "title", "items"],
      "additionalProperties": false,
      "description": "目录页（复用要点页版式）：3~6 条，每条 ≥4 字",
      "properties": {
        "type": { "const": "toc" },
        "title": { "type": "string", "minLength": 4, "maxLength": 24 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 4, "maxLength": 24 }
        }
      }
    },
    "pageSummary": {
      "type": "object",
      "required": ["type", "title", "items"],
      "additionalProperties": false,
      "description": "小结页（复用要点页版式）：标题 + 恰好 3 条、每条 ≥8 字",
      "properties": {
        "type": { "const": "summary" },
        "title": { "type": "string", "minLength": 4, "maxLength": 24 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 8, "maxLength": 28 },
          "description": "恰好 3 条，每条 ≥8 字"
        },
        "closing": { "type": "string", "maxLength": 40, "description": "底部一句收束（可选）" }
      }
    }
  }
}
