{
  "version": "0.1",
  "table": "赛道表（vertical）",
  "note": "赛道不做'写死归属'：① 用来给风格包排序（优先出该赛道的卡）② **可以从素材内容自动分析**（下方 detect 规则）③ 分析置信度低就落到 general。",
  "detect": {
    "note": "从用户素材自动判赛道（不靠人填）。三路证据加权，命中数排序取前 3 作为候选；最高分 < 阈值 ⇒ general。（★阈值 4→3：单个关键词命中=3 分，日常文案常常只有 1 个词；门槛 4 会导致\"永远落通用\"。实测旅游/餐饮各 1~4 个词都能正确判出。）",
    "signals": [
      {
        "src": "素材自带文字/用户文案关键词",
        "weight": 3,
        "how": "命中 hints 关键词表"
      },
      {
        "src": "素材图像主色与明度",
        "weight": 2,
        "how": "主色偏暖/冷、明度高/低 ⇒ 匹配 tokensHint"
      },
      {
        "src": "素材主体（可选，后期接入图像识别）",
        "weight": 2,
        "how": "人像/食物/风景/宠物/汽车…"
      }
    ],
    "threshold": 3,
    "fallback": "general"
  },
